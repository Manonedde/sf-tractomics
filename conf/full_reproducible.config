/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Same reproducibility settings as Tractoflow's `fully_reproducible` profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Tractoflow fully_reproducible:
        processes_denoise_dwi = 4       -> dwidenoise / mrdegibbs -nthreads 4
        processes_fodf        = 4       -> fODF --processes 4
        every other step                -> 1 thread (eddy, topup, ANTs BET,
                                           registration, N4, tracking, ...)
        ANTS_RANDOM_SEED = 1234, OPENBLAS_NUM_THREADS = 1, tracking seeds = 0
    All tractoflow steps also run in the same image as the Tractoflow port
    (scilus/scilus:2.2.2: FSL, ANTs, MRtrix, scilpy) instead of mrtrix3/scilpy.
----------------------------------------------------------------------------------------
*/

params.pft_random_seed   = 0
params.local_random_seed = 0
params.local_tracking_gpu = false

env {
    OPENBLAS_NUM_THREADS = 1
    TORCH_NUM_THREADS    = 1
}

process {
    // Default of 1 thread set on labels (not withName: '.*'), so that the
    // withName blocks below, some merged with earlier ones, keep priority.
    cpus = 1
    withLabel: '.*' {
        cpus = 1
    }

    withName: '.*:TRACTOFLOW:PREPROC_DWI:(DENOISE_DWI|DENOISE_REVDWI|PREPROC_GIBBS_DWI|PREPROC_GIBBS_REVDWI)' {
        cpus = 4
    }

    // Key must differ from the one in conf/modules/reconst_fodf.config:
    // an identical key replaces that block (ext.* and publishDir lost).
    withName: '.*:TRACTOFLOW:(RECONST_FODF)' {
        cpus = 4
    }

    // FreeSurfer-based modules keep their own image (not part of Tractoflow)
    withName: '^(?!.*(SYNTH|EASYREG|REGISTRATION_CONVERT)).*:TRACTOFLOW:.*' {
        container = 'scilus/scilus:2.2.2'
    }
}
