process {
    withName: ".*:BUNDLE_SEG:REGISTRATION_ANTS" {
        ext.quick = true
    }

    withName: '.*:OUTPUT_TEMPLATE_SPACE:REGISTRATION:REGISTRATION_ANTS' {
        ext.transform = 's'
        ext.quick = false
        publishDir = [
            [
                path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/anat/" : "${params.outdir}/${meta.id}/anat/" },
                mode: params.publish_dir_mode,
                saveAs: {
                    filename ->
                    def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                    if ( filename.contains("warped.nii.gz") ) { "${prefix}_space-${params.template}_desc-preproc_T1w.nii.gz" }
                    else if ( filename.contains("versions.yml") ) { null }
                }
            ],
            [
                path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/xfm/" : "${params.outdir}/${meta.id}/xfm/" },
                mode: params.publish_dir_mode,
                saveAs: {
                    filename ->
                    def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                    if ( filename.contains("_forward0_warp.nii.gz") ) { "${prefix}_from-dwi_to-${params.template}_mode-image_desc-warp_xfm.nii.gz" }
                    else if ( filename.contains("_forward1_affine.mat") ) { "${prefix}_from-dwi_to-${params.template}_mode-image_desc-affine_xfm.mat" }
                    else if ( filename.contains("_backward1_warp.nii.gz") ) { "${prefix}_from-${params.template}_to-dwi_mode-image_desc-warp_xfm.nii.gz" }
                    else if ( filename.contains("_backward0_affine.mat") ) { "${prefix}_from-${params.template}_to-dwi_mode-image_desc-affine_xfm.mat" }
                    else if ( filename.contains("versions.yml") ) { null }
                }
            ]
        ]
    }
}
