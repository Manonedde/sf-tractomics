process {
    withName: '.*:TRACTOFLOW:T1_REGISTRATION:REGISTRATION_ANATTODWI' {
        ext.run_qc              = true
        publishDir = [
            [
                // Based on: https://bids.neuroimaging.io/extensions/beps/bep_014.html
                path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/xfm" : "${params.outdir}/${meta.id}/xfm" },
                mode: params.publish_dir_mode,
                enabled: params.clean_output,
                pattern: "*{warp.nii.gz,affine.mat}",
                saveAs: { filename ->
                    def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                    if (filename.endsWith("_forward1_affine.mat")) { "${prefix}_from-T1w_to-dwi_mode-image_desc-affine_xfm.mat" }
                    else if (filename.endsWith("_forward0_warp.nii.gz")) { "${prefix}_from-T1w_to-dwi_mode-image_desc-warp_xfm.nii.gz" }
                    else if (filename.endsWith("_backward1_warp.nii.gz")) { "${prefix}_from-dwi_to-T1w_mode-image_desc-warp_xfm.nii.gz" }
                    else if (filename.endsWith("_backward0_affine.mat")) { "${prefix}_from-dwi_to-T1w_mode-image_desc-affine_xfm.mat" }
                    else { null }
                }
            ],
            [
                path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/anat" : "${params.outdir}/${meta.id}/anat" },
                mode: params.publish_dir_mode,
                enabled: params.clean_output,
                pattern: "*warped.nii.gz",
                saveAs: { filename ->
                    def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                    if (filename.endsWith("warped.nii.gz")) { "${prefix}_space-dwi_desc-preproc_T1w.nii.gz" }
                    else { null }
                }
            ]
        ]
    }
}
