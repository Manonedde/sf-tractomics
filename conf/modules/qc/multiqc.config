process {
    withName: "MULTIQC" {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\" --verbose" : "--verbose" }
        ext.single_subject = true
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/multiqc/" : "${params.outdir}/${meta.id}/multiqc/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: "MULTIQC_GLOBAL" {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\" --verbose" : "--verbose" }
        ext.single_subject = false
        publishDir = [
            path: { "${params.outdir}/multiqc/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
}
