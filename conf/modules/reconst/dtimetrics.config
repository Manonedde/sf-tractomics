process {
    withName: ".*:TRACTOFLOW:RECONST_DTIMETRICS" {
        ext.ad                  = true
        ext.evecs               = true
        ext.evals               = true
        ext.fa                  = true
        ext.ga                  = true
        ext.rgb                 = true
        ext.md                  = true
        ext.mode                = true
        ext.norm                = true
        ext.rd                  = true
        ext.tensor              = true
        ext.nonphysical         = true
        ext.pulsation           = true
        ext.residual            = true
        ext.max_dti_shell_value = { params.max_dti_shell_value }
        ext.dti_shells          = { params.dti_shells }
        ext.run_qc              = true
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains("ad.nii.gz") ) { "${prefix}_model-tensor_param-ad_dwimap.nii.gz" }
                else if ( filename.contains("fa.nii.gz") ) { "${prefix}_model-tensor_param-fa_dwimap.nii.gz" }
                else if ( filename.contains("rd.nii.gz") ) { "${prefix}_model-tensor_param-rd_dwimap.nii.gz" }
                else if ( filename.contains("md.nii.gz") ) { "${prefix}_model-tensor_param-md_dwimap.nii.gz" }
                else if ( filename.contains("mode.nii.gz") ) { "${prefix}_model-tensor_param-mode_dwimap.nii.gz" }
                else if ( filename.contains("tensor.nii.gz") ) { "${prefix}_model-tensor_param-tensor_dwimap.nii.gz" }
                else if ( filename.contains("rgb.nii.gz") ) { "${prefix}_model-tensor_param-rgb_dwimap.nii.gz" }
                else if ( filename.contains("ga.nii.gz") ) { "${prefix}_model-tensor_param-ga_dwimap.nii.gz" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: ".*:FW_CORRECTED_DTIMETRICS" {
        ext.prefix = { [meta.id, meta.session?: "", meta.run ?: "", "desc-fwc"].findAll { x -> x }.join("_") }
        ext.ad                  = true
        ext.evecs               = true
        ext.evals               = true
        ext.fa                  = true
        ext.ga                  = true
        ext.rgb                 = true
        ext.md                  = true
        ext.mode                = true
        ext.norm                = true
        ext.rd                  = true
        ext.tensor              = true
        ext.nonphysical         = true
        ext.pulsation           = true
        ext.residual            = true
        ext.max_dti_shell_value = { params.max_dti_shell_value }
        ext.dti_shells          = { params.dti_shells }
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains("ad.nii.gz") ) { "${prefix}_model-tensor_param-ad_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("fa.nii.gz") ) { "${prefix}_model-tensor_param-fa_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("rd.nii.gz") ) { "${prefix}_model-tensor_param-rd_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("md.nii.gz") ) { "${prefix}_model-tensor_param-md_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("mode.nii.gz") ) { "${prefix}_model-tensor_param-mode_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("tensor.nii.gz") ) { "${prefix}_model-tensor_param-tensor_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("rgb.nii.gz") ) { "${prefix}_model-tensor_param-rgb_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("ga.nii.gz") ) { "${prefix}_model-tensor_param-ga_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }
}
