params {
    //**NODDI**//
    run_noddi                           = false
    noddi_silence_single_shell_warnings = false
    noddi_lambda1                       = 0.5
    noddi_lambda2                       = 1e-3
}

process {
    withName: ".*:RECONST_NODDI" {
        memory = { 8.GB * task.attempt }
        ext.para_diff     = { params.para_diff }
        ext.iso_diff      = { params.iso_diff }
        ext.noddi_lambda1 = { params.noddi_lambda1 }
        ext.noddi_lambda2 = { params.noddi_lambda2 }
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains("icvf.nii.gz") ) { "${prefix}_model-noddi_param-icvf_dwimap.nii.gz" }
                else if ( filename.contains("odi.nii.gz") ) { "${prefix}_model-noddi_param-odi_dwimap.nii.gz" }
                else if ( filename.contains("isovf.nii.gz") ) { "${prefix}_model-noddi_param-isovf_dwimap.nii.gz" }
                else if ( filename.contains("dir.nii.gz") ) { "${prefix}_model-noddi_param-dir_dwimap.nii.gz" }
                else if ( filename.contains("ecvf.nii.gz") ) { "${prefix}_model-noddi_param-ecvf_dwimap.nii.gz" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }
}
