params {
    //**Q-Ball**//
    run_qball              = false
    use_qball_for_tracking = false
}

process {
    withName: ".*:RECONST_QBALL" {
        ext.gfa             = true
        ext.peaks           = true
        ext.peak_indices    = true
        ext.qball           = true
        ext.nufo            = true
        ext.a_power         = true
        ext.b0_threshold    = { params.b0_thr_extract_b0 }
        ext.sh_order        = { params.sh_order }
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains("gfa.nii.gz") ) { "${prefix}_model-qball_param-gfa_dwimap.nii.gz" }
                else if ( filename.contains("peaks.nii.gz") ) { "${prefix}_model-qball_param-peaks_dwimap.nii.gz" }
                else if ( filename.contains("nufo.nii.gz") ) { "${prefix}_model-qball_param-nufo_dwimap.nii.gz" }
                else if ( filename.contains("qball.nii.gz") ) { "${prefix}_model-qball_param-sh_dwimap.nii.gz" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }
}
