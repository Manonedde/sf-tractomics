params {
    //**Extract fODF shells using this value as minimum**//
    min_fodf_shell_value  = 700
    fodf_shells           = null

    //**Compute fODF metrics**//
    fodf_metrics_a_factor = 2.0
    relative_threshold    = 0.1
    max_fa_in_ventricle   = 0.1
    min_md_in_ventricle   = 0.003
}

process {
    withName: ".*:TRACTOFLOW:RECONST_FODF" {
        ext.b0_thr_extract_b0       = { params.b0_thr_extract_b0 }
        ext.dwi_shell_tolerance     = { params.dwi_shell_tolerance }
        ext.min_fodf_shell_value    = { params.min_fodf_shell_value }
        ext.fodf_shells             = { params.fodf_shells }
        ext.sh_order                = { params.sh_order }
        ext.sh_basis                = { params.basis }
        ext.fa_threshold            = { params.max_fa_in_ventricle }
        ext.md_threshold            = { params.min_md_in_ventricle }
        ext.relative_threshold      = { params.relative_threshold }
        ext.fodf_metrics_a_factor   = { params.fodf_metrics_a_factor }
        ext.absolute_peaks          = true
        ext.peaks                   = true
        ext.peak_indices            = true
        ext.afd_max                 = true
        ext.afd_total               = true
        ext.afd_sum                 = true
        ext.nufo                    = true

        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains("__fodf.nii.gz") ) { "${prefix}_model-csd_param-sh_dwimap.nii.gz" }
                else if ( filename.contains("wm_fodf.nii.gz") ) { "${prefix}_model-csd_param-wmsh_dwimap.nii.gz" }
                else if ( filename.contains("gm_fodf.nii.gz") ) { "${prefix}_model-csd_param-gmsh_dwimap.nii.gz" }
                else if ( filename.contains("csf_fodf.nii.gz") ) { "${prefix}_model-csd_param-csfsh_dwimap.nii.gz" }
                else if ( filename.contains("peaks.nii.gz") ) { "${prefix}_model-csd_param-peaks_dwimap.nii.gz" }
                else if ( filename.contains("afd_total.nii.gz") ) { "${prefix}_model-csd_param-afdtotal_dwimap.nii.gz" }
                else if ( filename.contains("nufo.nii.gz") ) { "${prefix}_model-csd_param-nufo_dwimap.nii.gz" }
                else if ( filename.contains("afd_max.nii.gz") ) { "${prefix}_model-csd_param-afdmax_dwimap.nii.gz" }
                else if ( filename.contains("afd_sum.nii.gz") ) { "${prefix}_model-csd_param-afdsum_dwimap.nii.gz" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }
}
