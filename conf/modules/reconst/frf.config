params {
    //**Compute fiber response function (frf)**//
    fa         = 0.7
    min_fa     = 0.5
    min_nvox   = 300
    roi_radius = 20
    manual_frf = "15,4,4"
}

process {
    withName: ".*:TRACTOFLOW:RECONST_FRF" {
        ext.fa          = { params.fa }
        ext.fa_min      = { params.min_fa }
        ext.nvox_min    = { params.min_nvox }
        ext.roi_radius  = { params.roi_radius }
        ext.set_frf     = { params.manual_frf ? true : false }
        ext.manual_frf  = { params.manual_frf }

        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains("__frf.txt") ) { "${prefix}_frf.txt" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }
}
