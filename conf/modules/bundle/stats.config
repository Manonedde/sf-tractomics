process {
    withName: ".*:BUNDLE_STATS" {
        ext.density_weighting = true
        ext.normalize_weights = true
        ext.length_stats = true
        ext.endpoints = true
        ext.mean_std = true
        ext.volume = true
        ext.volume_per_labels = true
        ext.mean_std_per_point = true
        ext.lesions_stats = false
        ext.min_lesion_vol = 7
        ext.meta_columns = { params.tractometry_covariates.split(",") }
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi" : "${params.outdir}/${meta.id}/dwi" },
            mode: params.publish_dir_mode,
            enabled: params.clean_output,
            saveAs: { filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if (filename.endsWith("_desc-point_param-lesions_stats.tsv")) { "${prefix}_label-point_param-lesions_desc-tractometry_stats.tsv" }
                else if (filename.endsWith("_desc-mean_param-lesions_stats.tsv")) { "${prefix}_label-mean_param-lesions_desc-tractometry_stats.tsv" }
                else if (filename.endsWith("_desc-mean_stats.tsv")) { "${prefix}_label-mean_desc-tractometry_stats.tsv" }
                else if (filename.endsWith("_desc-point_stats.tsv")) { "${prefix}_label-point_desc-tractometry_stats.tsv" }
                else { null }
            }
        ]
    }
}
