params {
    //**DWI: Denoise (dwidenoise in Mrtrix3)**//
    run_dwi_denoising = true
    extent            = 7
}

process {
    withName: ".*:TRACTOFLOW:PREPROC_DWI:DENOISE_DWI" {
        ext.extent = { params.extent }
    }

    withName: ".*:TRACTOFLOW:PREPROC_DWI:DENOISE_REVDWI" {
        ext.extent = { params.extent }
    }
}
