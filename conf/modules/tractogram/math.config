process {
    withName: ".*:ENSEMBLE_TRACKING" {
        memory = { 3 * trks.inject( 0.Gb ){ total, trk -> total + (trk.size() as MemoryUnit) } + 500.Mb }

        ext.operation       = "union"
        ext.save_indices    = true
        ext.save_empty      = true
        ext.no_bbox_check   = true
        ext.suffix          = "ensemble"

        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains("ensemble.trk") ) { "${prefix}_desc-ensemble_tractogram.trk" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }
}
