params {
    //**T1: Denoise**//
    template_t1     = null

    //**T1: BET**//
    run_t1_ants_bet = true
}

process {
    withName: ".*:TRACTOFLOW:PREPROC_T1:BETCROP_ANTSBET" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/anat/" : "${params.outdir}/${meta.id}/anat/" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if (filename.endsWith("t1_bet.nii.gz")) { "${prefix}_T1w.nii.gz" }
                else if (filename.endsWith("t1_bet_mask.nii.gz")) { "${prefix}_desc-brain_mask.nii.gz" }
                else { null }
            },
            enabled: params.clean_output
        ]
    }
}
