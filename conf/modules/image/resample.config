params {
    //**DWI: Resample**//
    run_dwi_resampling = true
    dwi_resolution     = 1
    dwi_interpolation  = "lin"

    //**T1: Resample**//
    run_t1_resampling  = true
    t1_resolution      = 1
    t1_interpolation   = "lin"
}

process {
    withName: ".*:TRACTOFLOW:PREPROC_DWI:RESAMPLE_DWI" {
        ext.voxel_size      = { params.dwi_resolution }
        ext.interp          = { params.dwi_interpolation }
        ext.first_suffix    = "dwi"
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains("_resampled.nii.gz") ) { "${prefix}_desc-preproc_dwi.nii.gz" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: ".*:TRACTOFLOW:PREPROC_DWI:RESAMPLE_MASK" {
        ext.interp          = "nn"
        ext.first_suffix    = "dwi_mask"
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains("_resampled.nii.gz") ) { "${prefix}_desc-brain_mask.nii.gz" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: ".*:TRACTOFLOW:PREPROC_T1:IMAGE_RESAMPLE" {
        ext.voxel_size      = { params.t1_resolution }
        ext.interp          = { params.t1_interpolation }
        ext.first_suffix    = "t1"
    }
}
