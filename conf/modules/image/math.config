process {
    withName: ".*:TRACTOFLOW:IMAGE_MATH" {
        ext.operation = "multiplication"
        ext.data_type   = "float32"
        ext.suffix = "fa_masked"
    }

    withName: '.*ATLAS_IIT:THR_BUNDLE_MASK' {
        ext.prefix = { "${meta.id}" }
        memory        = 1.GB
        time          = 20.M
    }

    withName: '.*ATLAS_IIT:SMOOTH_MASK' {
        memory        = 1.GB
        time          = 20.M
    }

    withName: '.*ATLAS_IIT:THR_SMOOTHED_MASK' {
        memory        = 1.GB
        time          = 20.M
    }
}
